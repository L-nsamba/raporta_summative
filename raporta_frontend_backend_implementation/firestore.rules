rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Areas are public so the registration dropdown can load before sign-in
    match /areas/{areaId} {
      allow read: if true;
      allow write: if false;
    }

    // Interim rule: everything else needs a signed-in user
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}