
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------
    // Authentication and role helpers
    // ------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function userProfileExists() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function currentUserRole() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    function isCitizen() {
      return userProfileExists()
        && currentUserRole() == 'citizen';
    }

    function isOfficial() {
      return userProfileExists()
        && currentUserRole() == 'official';
    }

    // ------------------------------------
    // Reference data helpers
    // ------------------------------------

    function isValidArea(areaId) {
      return areaId is string
        && exists(
          /databases/$(database)/documents/areas/$(areaId)
        );
    }

    function isValidAgency(agencyId) {
      return agencyId is string
        && exists(
          /databases/$(database)/documents/agencies/$(agencyId)
        )
        && get(
          /databases/$(database)/documents/agencies/$(agencyId)
        ).data.agencyId == agencyId;
    }

    function isActiveReport() {
      return 'deletedAt' in resource.data
        && resource.data.deletedAt == null;
    }

    // ------------------------------------
    // Report status transition validation
    // ------------------------------------

    function isValidStatusTransition(oldStatus, newStatus) {
      return
        (oldStatus == 'pending'
          && newStatus in ['under_review', 'declined'])
        ||
        (oldStatus == 'under_review'
          && newStatus in ['forwarded', 'declined'])
        ||
        (oldStatus == 'forwarded'
          && newStatus in ['in_progress', 'declined'])
        ||
        (oldStatus == 'in_progress'
          && newStatus in ['resolved', 'declined']);
    }

    function hasValidModerationData() {
      return
        (
          request.resource.data.status == 'declined'
          && request.resource.data.declineReason in [
            'duplicate',
            'unrelated',
            'already_resolved',
            'other'
          ]
          && (
            request.resource.data.declineFeedback == null
            || request.resource.data.declineFeedback is string
          )
        )
        ||
        (
          request.resource.data.status != 'declined'
          && request.resource.data.declineReason == null
          && request.resource.data.declineFeedback == null
        );
    }

    
    function statusNotificationMessage(status) {
      return status == 'under_review'
        ? 'Your report has been approved and is now under review.'
        : status == 'forwarded'
        ? 'Your report has been forwarded to the relevant agency.'
        : status == 'in_progress'
        ? 'Work on your reported issue is now in progress.'
        : status == 'resolved'
        ? 'Your reported issue has been resolved.'
        : status == 'declined'
        ? 'Your report has been declined. View the report for more details.'
        : '';
    }

    function hasValidNotificationData() {
      let data = request.resource.data;

      return data.keys().hasAll([
          'userId',
          'reportId',
          'message',
          'read',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'reportId',
          'message',
          'read',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string
        && data.reportId is string
        && data.message is string
        && data.read == false
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidStatusNotification(notificationId) {
      let data = request.resource.data;

      let reportPath =
        /databases/$(database)/documents/reports/$(data.reportId);

      let before = get(reportPath).data;
      let after = getAfter(reportPath).data;

      return
        // The report must exist and not be deleted.
        before.deletedAt == null
        && after.deletedAt == null

        // A legitimate status transition must occur.
        && isValidStatusTransition(
          before.status,
          after.status
        )

        // The notification must go to the report owner.
        && data.userId == before.userId
        && after.userId == before.userId

        // The notification ID must match the status event.
        && notificationId ==
          data.reportId + '_status_' + after.status

        // The message must match the new status.
        && data.message ==
          statusNotificationMessage(after.status)

        // The report must be updated in this request.
        && after.updatedAt == request.time;
    }

    function hasValidAgencyAssignment() {
      return
        (
          request.resource.data.status in [
            'forwarded',
            'in_progress',
            'resolved'
          ]
          && isValidAgency(request.resource.data.agencyId)
        )
        ||
        (
          request.resource.data.status in [
            'pending',
            'under_review',
            'declined'
          ]
          && (
            request.resource.data.agencyId == null
            || isValidAgency(request.resource.data.agencyId)
          )
        );
    }

      function isPublicReport() {
        return resource.data.status in [
          'under_review',
          'forwarded',
          'in_progress',
          'resolved'
        ];
      }

      function isReportOwner() {
        return isSignedIn()
          && resource.data.userId == request.auth.uid;
      }

      function canReadReport() {
        return isSignedIn()
          && isActiveReport()
          && (
            isOfficial()
            || isReportOwner()
            || isPublicReport()
          );
      }


    function hasRequiredStatusNotification(reportId) {
      let newStatus = request.resource.data.status;

      let notificationId =
        reportId + '_status_' + newStatus;

      let notificationPath =
        /databases/$(database)/documents/notifications/$(notificationId);

      let notification = getAfter(notificationPath).data;

      return
        // The notification must not already exist.
        !exists(notificationPath)

        // The notification must be created in this batch.
        && existsAfter(notificationPath)

        // Validate the associated report and recipient.
        && notification.reportId == reportId
        && notification.userId == resource.data.userId

        // Validate the message and initial read status.
        && notification.message ==
          statusNotificationMessage(newStatus)
        && notification.read == false

        // Ensure it is created during this request.
        && notification.createdAt == request.time
        && notification.updatedAt == request.time;
    }



    // ------------------------------------
    // Areas
    // ------------------------------------

    match /areas/{areaId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------
    // Agencies
    // ------------------------------------

    match /agencies/{agencyId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ------------------------------------
    // User profiles
    // ------------------------------------

    match /users/{userId} {

      // Users can read their own profile.
      allow read: if isSignedIn()
        && request.auth.uid == userId;

      // Public registration can only create citizen profiles.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.role == 'citizen'
        && request.resource.data.keys().hasOnly([
          'userId',
          'name',
          'email',
          'role',
          'areaId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.areaId is string
        && isValidArea(request.resource.data.areaId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Users can update basic profile information only.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'areaId',
            'updatedAt'
          ])
        && request.resource.data.name is string
        && request.resource.data.areaId is string
        && isValidArea(request.resource.data.areaId)
        && request.resource.data.updatedAt == request.time;

      // Profiles cannot be deleted from the client.
      allow delete: if false;
    }

    // ------------------------------------
    // Reports
    // ------------------------------------

    match /reports/{reportId} {

      // Officials can read all non-deleted reports.
      // Citizens can read their own reports and public reports.
      allow read: if canReadReport();

      // Citizens can create their own reports.
      allow create: if isCitizen()
        && request.resource.data.keys().hasOnly([
          'userId',
          'areaId',
          'category',
          'description',
          'lat',
          'lng',
          'locationDescription',
          'photoUrl',
          'status',
          'declineReason',
          'declineFeedback',
          'agencyId',
          'createdAt',
          'updatedAt',
          'deletedAt'
        ])
        && request.resource.data.keys().hasAll([
          'userId',
          'areaId',
          'category',
          'description',
          'lat',
          'lng',
          'locationDescription',
          'photoUrl',
          'status',
          'declineReason',
          'declineFeedback',
          'agencyId',
          'createdAt',
          'updatedAt',
          'deletedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && isValidArea(request.resource.data.areaId)
        && request.resource.data.category is string
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.lat is number
        && request.resource.data.lat >= -90
        && request.resource.data.lat <= 90
        && request.resource.data.lng is number
        && request.resource.data.lng >= -180
        && request.resource.data.lng <= 180
        && request.resource.data.locationDescription is string
        && request.resource.data.locationDescription.size() > 0
        && (
          request.resource.data.photoUrl == null
          || request.resource.data.photoUrl is string
        )
        && request.resource.data.status == 'pending'
        && request.resource.data.declineReason == null
        && request.resource.data.declineFeedback == null
        && request.resource.data.agencyId == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.deletedAt == null;

      // Officials can update moderation-related fields only.
      allow update: if isOfficial()
        && isActiveReport()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'agencyId',
            'declineReason',
            'declineFeedback',
            'updatedAt'
          ])
        && request.resource.data.updatedAt == request.time
        && isValidStatusTransition(
          resource.data.status,
          request.resource.data.status
        )
        && hasValidAgencyAssignment()
        && hasValidModerationData();

      // Citizens can soft-delete their own pending reports.
      allow update: if isCitizen()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && isActiveReport()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'deletedAt',
            'updatedAt'
          ])
        && request.resource.data.deletedAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Hard deletion is not allowed from the client.
      allow delete: if false;

      // ------------------------------------
      // Report upvotes
      // ------------------------------------
      match /upvotes/{userId} {

        function parentReportIsActive() {
          return exists(
            /databases/$(database)/documents/reports/$(reportId)
          )
          && get(
            /databases/$(database)/documents/reports/$(reportId)
          ).data.deletedAt == null;
        }

        function parentReportIsPublic() {
          return parentReportIsActive()
            && get(
              /databases/$(database)/documents/reports/$(reportId)
            ).data.status in [
              'under_review',
              'forwarded',
              'in_progress',
              'resolved'
            ];
        }

        allow read: if isSignedIn()
          && parentReportIsPublic();

        allow create: if isSignedIn()
          && request.auth.uid == userId
          && parentReportIsPublic()
          && request.resource.data.keys().hasOnly([
            'userId',
            'createdAt'
          ])
          && request.resource.data.userId == userId
          && request.resource.data.createdAt == request.time;

        allow delete: if isSignedIn()
          && request.auth.uid == userId
          && parentReportIsPublic();

        allow update: if false;
      }

    }

  // ------------------------------------
  // Notifications
  // ------------------------------------

    match /notifications/{notificationId} {

      // Users can only read their own notifications.
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      // Officials can create valid report status notifications.
      allow create: if isOfficial()
        && hasValidNotificationData()
        && isValidStatusNotification(notificationId);

      // Users may only mark their own notifications as read.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid

        // Only these two fields may change.
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['read', 'updatedAt'])

        // Notification must currently be unread.
        && resource.data.read == false

        // The new read status must be true.
        && request.resource.data.read == true

        // Timestamp must reflect the server request time.
        && request.resource.data.updatedAt == request.time;

      // Users cannot delete notifications.
      allow delete: if false;
    }


    // ------------------------------------
    // Default deny
    // ------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
